{
  "name": "@getzazu/cli",
  "version": "0.1.0",
  "description": "Command-line interface for the Zazu API.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/getzazu/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getzazu/cli.git"
  },
  "bugs": {
    "url": "https://github.com/getzazu/cli/issues"
  },
  "keywords": [
    "zazu",
    "cli",
    "api",
    "invoices",
    "payments"
  ],
  "bin": {
    "zazu": "./bin/zazu.ts"
  },
  "files": [
    "bin",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "bun@1.3.11",
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "bun ./bin/zazu.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun build --target=bun --outfile=dist/.check/zazu-cli-check ./bin/zazu.ts",
    "compile": "bun build --compile --outfile=dist/zazu ./bin/zazu.ts",
    "build": "scripts/build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0"
  }
}
